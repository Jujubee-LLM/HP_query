# ========= OpenAI =========
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 兼容需要自定义网关/代理的场景（例如 one-api / openai compatible）
# 留空则使用官方默认
OPENAI_BASE_URL=
# 性能优先建议用 small（更快、更便宜）；质量优先用 large（更慢）
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_CHAT_MAX_TOKENS=900
OPENAI_TIMEOUT_SECONDS=60
OPENAI_EMBED_TIMEOUT_SECONDS=15
OPENAI_CHAT_TIMEOUT_SECONDS=60

# ========= Optional: Split Chat/Embed Providers =========
# Use this when you want to keep embeddings on OpenAI (no FAISS rebuild),
# but switch chat generation to another OpenAI-compatible endpoint (e.g. qwen-turbo).
# If these are empty, the service falls back to OPENAI_*.
CHAT_API_KEY=
CHAT_BASE_URL=
CHAT_MODEL=
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=

# ========= Auth =========
# 研究员账号（用于 UI / API）
AUTH_USERNAME=researcher
AUTH_PASSWORD=change_me

# 管理员账号（可下载审计日志）
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=change_me_too

# ========= Backend =========
# Docker 构建时使用的 Python 版本（默认 3.11；注意：3.13 可能因 faiss-cpu wheel 缺失导致构建失败）
PYTHON_VERSION=3.11
SESSION_SECRET=change_me_session_secret
WEB_ORIGIN=http://localhost:3000

# 检索阈值策略（一般不需要用户调整）
RETRIEVAL_TOP_K_DEFAULT=16
RETRIEVAL_MIN_KEEP=1
RETRIEVAL_SCORE_DELTA=0.12
RETRIEVAL_GAP_THRESHOLD=0.10
# 可选：超出知识库时的拒答门槛（向量余弦相似度；留空表示不用）
RETRIEVAL_MIN_SCORE=0.25

# 可选：混合检索（BM25 + 向量），0~1 表示向量权重（关闭请留空）
# RETRIEVAL_HYBRID_ALPHA=0.7

# 可选：Rerank 精排（召回后对候选证据做最终排序；开启后 used_chunks[].score 为 rerank 分数）
# RETRIEVAL_RERANK_ENABLED=true
# RETRIEVAL_RERANK_CANDIDATES=24
# RETRIEVAL_RERANK_MAX_CHARS=800
# RETRIEVAL_RERANK_MODEL=gpt-4.1-mini
# 可选：使用本地 rerank 服务（推荐）
# RETRIEVAL_RERANK_BASE_URL=http://rerank:9001
# RETRIEVAL_RERANK_HTTP_TIMEOUT_SECONDS=10

# ========= 本地 Rerank 服务（bge-reranker-base）=========
# RERANK_MODEL_ID=BAAI/bge-reranker-base
# RERANK_DEVICE=cpu
# RERANK_PASSAGE_MAX_CHARS=800
# RERANK_BATCH_SIZE=16
# RERANK_PRELOAD_MODEL=false

# 可选：查询扩展（multi-query 召回；在召回阶段用加权 RRF 融合多条查询的候选）
# RETRIEVAL_EXPAND_ENABLED=true
# RETRIEVAL_EXPAND_N=2
# RETRIEVAL_EXPAND_MODEL=gpt-4.1-mini
# RETRIEVAL_EXPAND_RRF_K0=60
# RETRIEVAL_EXPAND_WEIGHT_ORIGINAL=1.0
# RETRIEVAL_EXPAND_WEIGHT_EXTRA=0.7

# 可选：词面重叠拒答（当 top-1 向量相似度不高时，用“查询-证据”词面重叠做第二道门槛）
# 重叠 token 基于中文 bigram + 英文/数字 token
RETRIEVAL_MIN_QUERY_TOKEN_OVERLAP=2
RETRIEVAL_OVERLAP_GATE_MAX_SCORE=0.32

# ========= RAG 性能（重要：影响回答速度）=========
# 发送给大模型的证据 chunks 上限（越小越快；建议 4~8）
RAG_MAX_CHUNKS=8
# 每个 chunk 发送给大模型的最大字符数（越小越快）
RAG_EVIDENCE_CHUNK_MAX_CHARS=800
# 所有 chunk 合计的最大字符数（强烈建议保留；防止 prompt 过长导致几十秒延迟）
RAG_EVIDENCE_TOTAL_MAX_CHARS=8000

# ========= 检索性能 =========
# embeddings 不可用/过慢时，是否降级为 BM25-only（保持可用性与时延上限）
RETRIEVAL_FALLBACK_BM25_ON_EMBED_FAILURE=true
# query embedding LRU 缓存大小（对重复提问有效；0 关闭）
RETRIEVAL_QUERY_EMBED_CACHE_SIZE=256

# ingest 抽取配置
# auto 会优先使用 pdfminer（更稳），失败再退回 pypdf
INGEST_EXTRACTOR=auto
INGEST_MIN_NONEMPTY_PAGES=5
INGEST_MIN_TOTAL_CHARS=2000
# PDF 合集常见“前置内容/目录”较多，可设置正文起始页（1-based；之前的页会被跳过但页码保持不变）
INGEST_CONTENT_START_PAGE=1
# 丢弃过短片段，避免把封面标题/目录行写进索引
INGEST_MIN_CHUNK_CHARS=120
# 分块策略（小说/叙事文本推荐：chunk 不要远大于 800，否则后续证据会被截断）
INGEST_CHUNK_MAX_CHARS=900
# chunk 之间 overlap 按“段落数”对齐，避免从句子中间截断（推荐 1~2）
INGEST_CHUNK_OVERLAP_PARAGRAPHS=1
# 仅用于“单段/单句过长时”的硬切滑窗重叠（字符数）
INGEST_CHUNK_HARD_CUT_OVERLAP_CHARS=150
INGEST_CHUNK_MERGE_MIN_CHARS=200
# ingest embeddings（换知识库时会跑 embeddings，网络不稳时建议降低 batch 并提高 timeout）
INGEST_EMBED_BATCH_SIZE=16
INGEST_EMBED_TIMEOUT_SECONDS=60
INGEST_EMBED_MAX_RETRIES=6
INGEST_EMBED_BACKOFF_SECONDS=1
INGEST_EMBED_BACKOFF_MAX_SECONDS=15

# 知识库 PDF 路径（容器内路径）
DATA_PDF_PATH=/app/data/book.pdf

# 向量库持久化目录（容器内路径）
FAISS_DIR=/app/storage/faiss
CHUNKS_PATH=/app/storage/chunks.jsonl
AUDIT_LOG_PATH=/app/storage/logs.jsonl

# ========= Frontend =========
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
